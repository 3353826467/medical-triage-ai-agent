# ============================================================
#  智能问诊 AI 客服系统 —— 环境变量示例
#  复制为 backend/.env 后按需修改；不配置 Key 也能启动（离线规则模式）
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 大模型（OpenAI 兼容协议）----------
# 留空 → 自动启用本地规则引擎，服务依旧可对话
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 轻量任务（意图识别等）使用的小模型，留空则复用 LLM_MODEL
LLM_MODEL_FAST=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 想用国内模型，只改下面两行即可（任选其一）：
# DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
# 通义千问:   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 智谱:       OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4-flash
# Moonshot:   OPENAI_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
# 本地 Ollama: OPENAI_BASE_URL=http://localhost:11434/v1          LLM_MODEL=qwen2.5:7b

# ---------- Embedding ----------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LOCAL_EMBEDDING_DIM=384

# ---------- Milvus ----------
# 未启动 Milvus 时会自动降级为本地向量索引，服务不受影响
MILVUS_ENABLED=true
# MILVUS_TARGET：连接目标。三种写法
#   1) 留空            → 按 MILVUS_HOST:MILVUS_PORT 拼成 http://...（Docker standalone）
#   2) http://host:19530 → 同上，显式写法
#   3) ./data/milvus.db  → Milvus Lite 嵌入式，免 Docker（需 pip install milvus_lite）
# ⚠️ 字段名不能改成 MILVUS_URI：pymilvus 自己会读同名环境变量当 gRPC 地址解析，
#    填本地路径会在 import 阶段直接抛 Illegal uri。
MILVUS_TARGET=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=medical_kb

# ---------- RAG ----------
TOP_K=4
SCORE_THRESHOLD=0.15
CHUNK_SIZE=500
CHUNK_OVERLAP=60
ENABLE_HYBRID_RERANK=true

# ---------- 安全 ----------
# 生产环境建议保持 false，避免给出具体用药剂量建议
ALLOW_MEDICATION_ADVICE=false

# 强制走本地规则引擎（离线演示 / 压测）
FORCE_RULE_ENGINE=false
